  "prompt_items": [
    {
      "effective_seed": 21001,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_001.txt",
      "sha256": "279552d591d1dda79928f78b9d8c7a3416e3739172f54917d3ea2de74b0f2cd3",
      "source_index": 1,
      "text": "A stunning mid-afternoon landscape with a low camera angle, showcasing several giant wooly mammoths treading through a snowy meadow. Their long, wooly fur gently billows as they move, creating natural movement. Snow-covered trees and dramatic snow-capped mountains loom in the distance. Wispy clouds and a high sun cast a warm glow, enhancing the serene and awe-inspiring atmosphere. The depth of field brings out detailed textures, capturing every nuance of these prehistoric giants in breathtaking clarity."
    },
    {
      "effective_seed": 21017,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_017.txt",
      "sha256": "b6c0bf4071a22fec35b9ba1e26e3ae3f29746960caa3aa470cbeffeed93992c5",
      "source_index": 17,
      "text": "A dynamic shot from behind a white vintage SUV with a black roof rack as it speeds up a steep dirt road surrounded by towering redwood trees on a rugged mountain slope. Dust kicks up from its tires, and the sunlight shines on the SUV, casting a warm glow. The dirt road curves gently into the distance, with dense redwoods on either side and patches of greenery. The car navigates the curve with ease, making it seem thrilling. The road is framed by steep hills and mountains, with a clear blue sky and wispy clouds. The camera captures the vehicle\u2019s powerful and adventurous journey."
    },
    {
      "effective_seed": 21033,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_033.txt",
      "sha256": "eebdfa0d5f71a01b408ebf038dfb50b9aac608705d8d6a81b5431e46433aca55",
      "source_index": 33,
      "text": "A cinematic 35mm film captures a dynamic step-printing scene of a young man with short, tousled brown hair and determined eyes sprinting down a city street lined with tall buildings and neon signs. His arms pump vigorously as he runs, looking focused and energetic. The background features blurred motion with the cityscape fading into a soft, sepia tone. The camera follows him closely, capturing every stride and movement. A nostalgic and vintage film texture enhances the dramatic intensity. Close-up shot from a slightly behind-the-subject angle."
    },
    {
      "effective_seed": 21049,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_049.txt",
      "sha256": "d09ec37d2b0de81fcb545dd821674211ced7e35da2c6280adf43a62ef40ce902",
      "source_index": 49,
      "text": "A detailed digital painting style illustration of a small man with a cheerful expression, wearing round glasses and a warm smile, holding several colorful building blocks. He stands near a large painting of a serene landscape in a modern art gallery filled with various artworks, including modern abstract and classic pieces. The polished wooden floor and comfortable chairs add to the ambiance. Soft, warm lighting highlights the textures. A medium shot from a slightly lower angle captures both the man and the gallery scene."
    },
    {
      "effective_seed": 21065,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_065.txt",
      "sha256": "7082e7e83559a83ac57d2a10754022e49053eb46dad776a2d3f024978e88c5b7",
      "source_index": 65,
      "text": "A vibrant and lively cartoon illustration of a panda playing the guitar. The panda has black and white fur, round eyes, and a friendly expression. It sits comfortably on a small stool, strumming the guitar with one paw while the other rests on its knee. The small acoustic guitar is plucked with precision. The background features a cozy room with plants and colorful decorations, creating a warm and inviting atmosphere. The camera angle is slightly from above, capturing the panda's joyful and focused performance."
    },
    {
      "effective_seed": 21081,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_081.txt",
      "sha256": "6f368ec4da2fb47d82b8422d4a428e0637c035a0198762e56accbecacd364e5d",
      "source_index": 81,
      "text": "A hyper-realistic digital art piece showing a wide-angle view inside a high-speed train moving through an old European city. The sleek, modern train interior has passengers seated in comfortable leather seats, reading books or using laptops. Clear windows display bustling streets, ancient cobblestone, ornate facades, and medieval spires rushing past at incredible speed. People walk hurriedly, and horse-drawn carriages pass by. The train's motion is vividly depicted, creating a sense of dynamic movement and adventure. The cityscape is richly detailed, blurred and streaked to emphasize speed. The atmosphere blends futuristic technology with historical charm."
    },
    {
      "effective_seed": 21097,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_097.txt",
      "sha256": "43549d00fd935f96da5c8942b8bcea91e45404fb09446fe54a1e50f82e142bf8",
      "source_index": 97,
      "text": "A dramatic moment in a realistic photographic style, showing a middle-aged bald man initially appearing solemn. Suddenly, a curly wig and sunglasses fall onto his head from above, transforming his appearance instantly. His face lights up with joy and surprise, eyes widening and a broad smile forming. He stands in a cluttered office space with scattered papers and a desk lamp casting shadows, creating a stark contrast. Taken from a low-angle perspective, emphasizing the dramatic change."
    },
    {
      "effective_seed": 21113,
      "path": "/apdcephfs_gy2/share_302533218/cedricnie/v210_runs/v210_lphc_789d8604_sixnode/inputs/prompts/source_113.txt",
      "sha256": "8b3b745beabcf081f26276ea13dbffa0bacaaa5a070a6961d30f67b630042293",
      "source_index": 113,
      "text": "A dramatic overhead aerial shot of the ocean, capturing a mesmerizing maelstrom forming in the water, swirling violently before revealing the fiery depths below. Intense churning water creates a whirlpool effect stretching from the surface to the murky depths, illuminating the underwater landscape with vivid colors and textures. The camera angle emphasizes the dynamic motion and vastness of the ocean."
    }
  ],
